{
  // The settings this repository needs an editor to have, and nothing that is
  // a matter of taste. Three codebases sit side by side here and each has a
  // formatter of its own; what follows is how an editor is told which is which.
  //
  // `.gitignore` keeps every other file under `.vscode/` out of the
  // repository, so this one is shared on purpose.

  // The width `packages/flutter` is written at.
  //
  // `dart format` reads it from `analysis_options.yaml`, and the editor's
  // extension has a setting of its own whose default is 80 — so a save with
  // that default reflows every Dart file in the package to a width CI then
  // rejects, without changing a line of code. The number is the same one
  // `analysis_options.yaml` and `run-test-flutter.yml` carry.
  "dart.lineLength": 100,

  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.formatOnSave": true,
    "editor.rulers": [100]
  },

  // `packages/react` and `docs` are Prettier's, which reads `.prettierrc` from
  // the folder the file is in. Each language is named rather than the default
  // formatter being set once, because Dart above is the exception and a
  // blanket default would be an exception to an exception.
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[vue]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // Saved as UTF-8 with LF endings, no trailing whitespace, one newline at the
  // end. The formatters already do this to what they touch; these cover the
  // files they do not.
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
