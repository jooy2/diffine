{
  "name": "diffine-react",
  "version": "1.0.0",
  "description": "Compare two versions and show what changed \u2014 a diff engine and a side-by-side viewer in one package, with syntax highlighting fetched only when a language is asked for.",
  "type": "module",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "author": "CDGet <jooy2.contact@gmail.com>",
  "license": "MIT",
  "homepage": "https://diffine.cdget.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jooy2/diffine",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/jooy2/diffine/issues"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc --project tsconfig.prod.json && node scripts/build-styles.mjs",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --report-unused-disable-directives --fix",
    "prepare": "npm run build",
    "size": "npm run build && node scripts/bundle-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.prod.json --noEmit && tsc --project test/tsconfig.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "module": "./dist/diff.js",
      "default": "./dist/diff.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "module": "./dist/image.js",
      "default": "./dist/image.js"
    },
    "./patch": {
      "types": "./dist/patch.d.ts",
      "module": "./dist/patch.js",
      "default": "./dist/patch.js"
    },
    "./text-diff": {
      "types": "./dist/text-diff.d.ts",
      "module": "./dist/text-diff.js",
      "default": "./dist/text-diff.js"
    },
    "./image-diff": {
      "types": "./dist/image-diff.d.ts",
      "module": "./dist/image-diff.js",
      "default": "./dist/image-diff.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "module": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "diff": [
        "dist/diff.d.ts"
      ],
      "image": [
        "dist/image.d.ts"
      ],
      "patch": [
        "dist/patch.d.ts"
      ],
      "text-diff": [
        "dist/text-diff.d.ts"
      ],
      "image-diff": [
        "dist/image-diff.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ]
    }
  },
  "keywords": [
    "diffine",
    "diffine-react",
    "diff",
    "diff-viewer",
    "text-diff",
    "image-diff",
    "pixel-diff",
    "visual-regression",
    "line-diff",
    "word-diff",
    "character-diff",
    "myers",
    "compare",
    "comparison",
    "side-by-side",
    "split-view",
    "unified-diff",
    "merge",
    "patch",
    "code-review",
    "react",
    "reactjs",
    "react-component",
    "typescript",
    "tsx",
    "esm",
    "accessible",
    "accessibility",
    "a11y",
    "syntax-highlighting",
    "highlight-js",
    "dark-mode"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  }
}
