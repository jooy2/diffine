{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    /*
     * Where the library and the things it imports are.
     *
     * `diffine-react` is the alias the demos use, and it points at source
     * rather than at `dist/` for the same reason the Vite alias does. The rest
     * of this map is the consequence: TypeScript resolves a bare specifier by
     * walking up from the file that wrote it, so the library's own
     * `import 'react'` looks in `packages/react/node_modules` and never in this
     * folder. That directory exists on a machine that has run `npm install` in
     * both places and does not exist in CI, which is where leaving this out
     * fails.
     *
     * `resolve.dedupe` in `.vitepress/config.ts` says the same thing to Vite.
     * Both have to be told, and anything added to one belongs in the other.
     */
    "paths": {
      "diffine-react": ["../packages/react/src/index.ts"],
      "diffine-react/diff": ["../packages/react/src/diff.ts"],
      "diffine-react/patch": ["../packages/react/src/patch.ts"],
      "diffine-react/types": ["../packages/react/src/types.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "highlight.js": ["./node_modules/highlight.js/types/index.d.ts"],
      "highlight.js/*": ["./node_modules/highlight.js/*"]
    }
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.tsx", ".vitepress/**/*.d.ts"]
}
